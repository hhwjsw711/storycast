{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storycast-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "memegineer.com/api/*", "zone_name": "memegineer.com" },
    { "pattern": "memegineer.com/m/*", "zone_name": "memegineer.com" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://memegineer.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "storycast", "database_id": "9f95cbd5-87e9-412b-86d6-e6ced17860cb" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "storycast-media" }],
  "ratelimits": [{ "name": "VOICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
